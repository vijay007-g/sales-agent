# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Where the config lives
SALESAGENT_CONFIG=config.yaml

# Dashboard login (username is "owner")
DASHBOARD_PASSWORD=change-me

# Channel mode: "console" (dry run, messages go to data/outbox.log) or "live"
CHANNEL_MODE=console

# WhatsApp Business Cloud API (Meta) - needed when CHANNEL_MODE=live
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string

# Email (SMTP) - optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret that lead sources (website form, Zapier/Make, portals) send in X-Webhook-Secret
LEAD_WEBHOOK_SECRET=change-me-too

# Public address of this server (used in form links sent to the team on WhatsApp)
PUBLIC_BASE_URL=https://sales.example.com

# Optional: Meta app secret to verify WhatsApp webhook signatures
WHATSAPP_APP_SECRET=
# Approved template (one {{1}} body variable) for messages outside the 24h window
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
